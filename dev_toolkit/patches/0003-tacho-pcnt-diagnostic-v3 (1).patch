-uint32_t PumpTachometer::computePhysicalMinPeriodUs(float maxMechanicalRpm, float pulsesPerRevolution) {
-    if (!(maxMechanicalRpm > 0.0f) || !(pulsesPerRevolution > 0.0f)) {
-        return 0;
