-    uint32_t holdoffUs = _config.holdoffMinUs;
-    if (_lastPeriodUs > 0) {
-        holdoffUs = std::clamp(_lastPeriodUs / 20U, _config.holdoffMinUs, _config.holdoffMaxUs);
-    }
