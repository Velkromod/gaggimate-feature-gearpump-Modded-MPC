+#include "PumpTachometer.h"
+
+#include <algorithm>
+
+bool PumpTachometer::begin(const Config &cfg) {
+    _cfg = cfg;
+    reset();
+
+    if (_cfg.pin == GPIO_NUM_NC) {
+        return false;
+    }
+
+    gpio_config_t io = {};
+    io.pin_bit_mask = (1ULL << _cfg.pin);
+    io.mode = GPIO_MODE_INPUT;
+    io.pull_up_en = GPIO_PULLUP_DISABLE;
+    io.pull_down_en = GPIO_PULLDOWN_DISABLE;
+    io.intr_type = GPIO_INTR_NEGEDGE;
+    if (gpio_config(&io) != ESP_OK) {
+        return false;
+    }
+
+#if GAGGIMATE_HAS_GPIO_GLITCH_FILTER
+    if (_cfg.enablePinGlitchFilter) {
+        gpio_pin_glitch_filter_config_t filterCfg = {
+            .gpio_num = _cfg.pin,
+        };
+        if (gpio_new_pin_glitch_filter(&filterCfg, &_glitchFilter) == ESP_OK) {
+            gpio_glitch_filter_enable(_glitchFilter);
+        }
+    }
+#endif
+
+    esp_err_t err = gpio_install_isr_service(0);
+    if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
+        return false;
+    }
+
+    gpio_isr_handler_remove(_cfg.pin);
+    if (gpio_isr_handler_add(_cfg.pin, &PumpTachometer::isrThunk, this) != ESP_OK) {
+        return false;
+    }
+
+    return true;
+}
+
+void PumpTachometer::reset() {
+    portENTER_CRITICAL(&_mux);
+    _lastEdgeUs = 0;
+    _lastPeriodUs = 0;
+    _pulseCount = 0;
+    _isrRejects = 0;
+    portEXIT_CRITICAL(&_mux);
+
+    _sample = {};
+    _plausibilityRejects = 0;
+    _lastConsumedPulseCount = 0;
+    _acceptedPeriodUs = 0;
+    _acceptedPeriods.fill(0);
+    _acceptedCount = 0;
+    _acceptedIndex = 0;
+}
+
+void IRAM_ATTR PumpTachometer::isrThunk(void *arg) {
+    static_cast<PumpTachometer *>(arg)->onEdgeIsr();
+}
+
+void IRAM_ATTR PumpTachometer::onEdgeIsr() {
+    const int64_t nowUs = esp_timer_get_time();
+
+    portENTER_CRITICAL_ISR(&_mux);
+
+    if (_lastEdgeUs != 0) {
+        const uint32_t dtUs = static_cast<uint32_t>(nowUs - _lastEdgeUs);
+
+        // Reject very short periods directly inside the ISR. These are usually
+        // caused by electrical noise or double-triggered edges.
+        if (dtUs < _cfg.minPeriodUs) {
+            _isrRejects++;
+            portEXIT_CRITICAL_ISR(&_mux);
+            return;
+        }
+
+        _lastPeriodUs = dtUs;
+    }
+
+    _lastEdgeUs = nowUs;
+    _pulseCount++;
+
+    portEXIT_CRITICAL_ISR(&_mux);
+}
+
+uint32_t PumpTachometer::medianOfWindow(const uint32_t *values, size_t count) {
+    uint32_t scratch[5] = {0, 0, 0, 0, 0};
+    for (size_t i = 0; i < count && i < 5; ++i) {
+        scratch[i] = values[i];
+    }
+    std::sort(scratch, scratch + count);
+    return scratch[count / 2];
+}
+
+void PumpTachometer::pushAcceptedPeriod(uint32_t periodUs) {
+    _acceptedPeriods[_acceptedIndex] = periodUs;
+    _acceptedIndex = (_acceptedIndex + 1) % _acceptedPeriods.size();
+    if (_acceptedCount < _acceptedPeriods.size()) {
+        _acceptedCount++;
+    }
+}
+
+void PumpTachometer::update() {
+    int64_t lastEdgeUs = 0;
+    uint32_t rawPeriodUs = 0;
+    uint32_t pulseCount = 0;
+    uint32_t isrRejects = 0;
+
+    portENTER_CRITICAL(&_mux);
+    lastEdgeUs = _lastEdgeUs;
+    rawPeriodUs = _lastPeriodUs;
+    pulseCount = _pulseCount;
+    isrRejects = _isrRejects;
+    portEXIT_CRITICAL(&_mux);
+
+    if (pulseCount != _lastConsumedPulseCount && rawPeriodUs > 0) {
+        bool accept = true;
+
+        // Once we have a short history, only accept new periods that stay
+        // reasonably close to the local median. This removes isolated outliers
+        // without making the ISR itself heavier.
+        if (_acceptedCount >= 3) {
+            const uint32_t medianPeriodUs = medianOfWindow(_acceptedPeriods.data(), _acceptedCount);
+            const float minAllowed = static_cast<float>(medianPeriodUs) * _cfg.plausibilityMinRatio;
+            const float maxAllowed = static_cast<float>(medianPeriodUs) * _cfg.plausibilityMaxRatio;
+            accept = static_cast<float>(rawPeriodUs) >= minAllowed && static_cast<float>(rawPeriodUs) <= maxAllowed;
+        }
+
+        if (accept) {
+            _acceptedPeriodUs = rawPeriodUs;
+            pushAcceptedPeriod(rawPeriodUs);
+        } else {
+            _plausibilityRejects++;
+        }
+
+        _lastConsumedPulseCount = pulseCount;
+    }
+
+    _sample.pulseCount = pulseCount;
+    _sample.glitchRejects = isrRejects + _plausibilityRejects;
+
+    const int64_t nowUs = esp_timer_get_time();
+    if (lastEdgeUs == 0 || _acceptedPeriodUs == 0 || (nowUs - lastEdgeUs) > _cfg.timeoutUs) {
+        _sample.periodUs = 0;
+        _sample.rpmInst = 0.0f;
+        _sample.rpmEma = 0.0f;
+        _sample.timedOut = true;
+        return;
+    }
+
+    _sample.periodUs = _acceptedPeriodUs;
+    _sample.rpmInst = 60000000.0f / (_cfg.pulsesPerRevolution * static_cast<float>(_acceptedPeriodUs));
+
+    if (_sample.rpmEma <= 0.0f) {
+        _sample.rpmEma = _sample.rpmInst;
+    } else {
+        _sample.rpmEma += _cfg.emaAlpha * (_sample.rpmInst - _sample.rpmEma);
+    }
+
+    _sample.timedOut = false;
+}
