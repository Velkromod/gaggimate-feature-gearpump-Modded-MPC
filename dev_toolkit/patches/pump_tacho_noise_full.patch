+#ifndef PUMPTACHOMETER_H
+#define PUMPTACHOMETER_H
+
+#include <Arduino.h>
+#include <driver/gpio.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/portmacro.h>
+
+#if defined(__has_include)
+#if __has_include("driver/gpio_filter.h")
+#include <driver/gpio_filter.h>
+#define GAGGIMATE_HAS_GPIO_GLITCH_FILTER 1
+#else
+#define GAGGIMATE_HAS_GPIO_GLITCH_FILTER 0
+#endif
+#else
+#define GAGGIMATE_HAS_GPIO_GLITCH_FILTER 0
+#endif
+
+#include <array>
+
+class PumpTachometer {
+  public:
+    struct Config {
+        gpio_num_t pin = GPIO_NUM_NC;
+        float pulsesPerRevolution = 2.0f;
+        uint32_t timeoutUs = 300000;
+        uint32_t minPeriodUs = 120;
+        float emaAlpha = 0.20f;
+        bool enablePinGlitchFilter = true;
+        float plausibilityMinRatio = 0.60f;
+        float plausibilityMaxRatio = 1.70f;
+    };
+
+    struct Sample {
+        uint32_t periodUs = 0;
+        float rpmInst = 0.0f;
+        float rpmEma = 0.0f;
+        uint32_t pulseCount = 0;
+        uint32_t glitchRejects = 0;
+        bool timedOut = true;
+    };
+
+    bool begin(const Config &cfg);
+    void reset();
+    void update();
+    const Sample &sample() const { return _sample; }
+
+  private:
+    static void IRAM_ATTR isrThunk(void *arg);
+    void IRAM_ATTR onEdgeIsr();
+
+    static uint32_t medianOfWindow(const uint32_t *values, size_t count);
+    void pushAcceptedPeriod(uint32_t periodUs);
+
+    Config _cfg{};
+    Sample _sample{};
+
+    portMUX_TYPE _mux = portMUX_INITIALIZER_UNLOCKED;
+
+    volatile int64_t _lastEdgeUs = 0;
+    volatile uint32_t _lastPeriodUs = 0;
+    volatile uint32_t _pulseCount = 0;
+    volatile uint32_t _isrRejects = 0;
+
+    uint32_t _plausibilityRejects = 0;
+    uint32_t _lastConsumedPulseCount = 0;
+    uint32_t _acceptedPeriodUs = 0;
+    std::array<uint32_t, 5> _acceptedPeriods{};
+    size_t _acceptedCount = 0;
+    size_t _acceptedIndex = 0;
+
+#if GAGGIMATE_HAS_GPIO_GLITCH_FILTER
+    gpio_glitch_filter_handle_t _glitchFilter = nullptr;
+#endif
+};
+
+#endif // PUMPTACHOMETER_H
